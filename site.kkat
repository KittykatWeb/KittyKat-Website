<kkat>

// Site info
var("site", "KittyKat Showcase")

// Global styles
style page {
    background color cream
}

style heading {
    text color navy
}

style button {
    background color navy
    text color white
    padding medium
    rounded
}

look("card") {
    background color white
    padding large
    rounded
    shadow
    margin medium
}

// Navigation component
component("nav") {
    row {
        pagelink("Home", "home")
        pagelink("Contact", "contact")
    }
    divider
}

// Footer component
component("footer") {
    divider
    small("Built with KittyKat")
}

// Home page
page("home") {

    title("KittyKat Showcase")

    use("nav")

    heading("Welcome to KittyKat")
    subheading("Build websites with plain English")

    paragraph("This simple showcase demonstrates pages, components, styling, tables, and forms.")

    row {

        styled("card") {
            heading("Simple")
            paragraph("Write readable website code without HTML and CSS.")
        }

        styled("card") {
            heading("Fast")
            paragraph("One file can generate an entire website.")
        }

        styled("card") {
            heading("Deploy Anywhere")
            paragraph("Build static files and upload them to any web host.")
        }
    }

    heading("Features")

    table {
        row {
            cell("Feature")
            cell("Included")
        }

        row {
            cell("Pages")
            cell("Yes")
        }

        row {
            cell("Components")
            cell("Yes")
        }

        row {
            cell("Forms")
            cell("Yes")
        }

        row {
            cell("Tables")
            cell("Yes")
        }
    }

    space

    button {
        text("Contact Us")
        goto("contact")
    }

    use("footer")
}

// Contact page
page("contact") {

    title("Contact")

    use("nav")

    heading("Get In Touch")

    paragraph("This form is for demonstration purposes.")

    form {
        input("Your Name")
        email("Email Address")
        textarea("Message")
        submit("Send Message")
    }

    heading("Why KittyKat?")

    list {
        item("Easy to learn")
        item("Single-file workflow")
        item("Static site output")
        item("Readable syntax")
    }

    button {
        text("Back Home")
        goto("home")
    }

    use("footer")
}

</kkat>
